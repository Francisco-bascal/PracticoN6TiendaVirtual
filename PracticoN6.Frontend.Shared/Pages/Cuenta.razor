@page "/cuenta"
@attribute [Authorize]
@inject TiendaApi Tienda
@inject SesionService Sesion
@inject CarritoService Carrito
@inject NotificacionesService Notificaciones
@inject NavigationManager Navegacion

<div class="container-md py-3">
    <EncabezadoPagina Titulo="Mi cuenta" Icono="person-circle" />

    <EstadoVista Cargando="_perfil == null" Error="@_error" Reintentar="CargarAsync">
        <div class="card shadow-sm mb-3">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-person-circle display-5 text-primary" aria-hidden="true"></i>
                <div class="min-w-0">
                    <div class="fw-bold">@_perfil!.NombreUsuario <span class="badge text-bg-primary ms-1">@_perfil.Rol</span></div>
                    <div class="small text-body-secondary text-break">@_perfil.Email</div>
                </div>
            </div>
        </div>

        <h2 class="h5">Mis datos</h2>
        <EditForm Model="_formulario" OnValidSubmit="Guardar">
            <ValidacionBootstrap />
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label for="nombre" class="form-label">Nombre</label>
                    <InputText id="nombre" class="form-control" @bind-Value="_formulario.Nombre" />
                    <ValidationMessage For="() => _formulario.Nombre" />
                </div>
                <div class="col-6">
                    <label for="apellido" class="form-label">Apellido</label>
                    <InputText id="apellido" class="form-control" @bind-Value="_formulario.Apellido" />
                </div>
            </div>
            <div class="mb-3">
                <label for="telefono" class="form-label">Teléfono</label>
                <InputText id="telefono" type="tel" class="form-control" @bind-Value="_formulario.Telefono" inputmode="tel" />
            </div>
            <div class="mb-3">
                <label for="direccion" class="form-label">Dirección</label>
                <InputText id="direccion" class="form-control" @bind-Value="_formulario.Direccion" />
            </div>
            <button class="btn btn-primary btn-lg w-100" type="submit" disabled="@_guardando">
                @if (_guardando)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                @(_guardando ? "Guardando..." : "Guardar cambios")
            </button>
        </EditForm>
    </EstadoVista>

    <h2 class="h5 mt-4">Sesión</h2>
    <div class="d-grid gap-2 d-sm-flex">
        <a class="btn btn-outline-secondary btn-lg flex-fill" href="servidor"><i class="bi bi-hdd-network me-1" aria-hidden="true"></i>Servidor</a>
        <button type="button" class="btn btn-danger btn-lg flex-fill" @onclick="CerrarSesion">
            <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Cerrar sesión
        </button>
    </div>
</div>

@code {
    private Perfil? _perfil;
    private FormularioPerfil _formulario = new();
    private string? _error;
    private bool _guardando;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _error = null;

        try
        {
            _perfil = await Tienda.ObtenerPerfilAsync();
            _formulario = new FormularioPerfil
            {
                Nombre = _perfil.Nombre ?? _perfil.NombreUsuario,
                Apellido = _perfil.Apellido,
                Telefono = _perfil.Telefono,
                Direccion = _perfil.Direccion
            };
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Guardar()
    {
        _guardando = true;

        try
        {
            _perfil = await Tienda.ActualizarPerfilAsync(_formulario);
            Notificaciones.Exito("Datos actualizados.");
        }
        catch (ApiException ex)
        {
            Notificaciones.Error(ex.Message);
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesionAsync();
        Navegacion.NavigateTo("login", replace: true);
    }
}
