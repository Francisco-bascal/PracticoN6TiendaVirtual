@page "/admin/clientes"
@attribute [Authorize(Roles = Roles.Personal)]
@inject TiendaApi Tienda

<div class="container-md py-3">
    <EncabezadoPagina Titulo="Clientes" Icono="people" />

    <EstadoVista Cargando="_pagina == null" Error="@_error" Vacio="_pagina?.Elementos.Count == 0" Reintentar="Cargar"
                 IconoVacio="people" MensajeVacio="Todavía no hay clientes.">
        <p class="small text-body-secondary mb-2">@_pagina!.TotalElementos @(_pagina.TotalElementos == 1 ? "cliente" : "clientes")</p>

        <ul class="list-group shadow-sm">
            @foreach (var cliente in _pagina.Elementos)
            {
                <li class="list-group-item" @key="cliente.ClienteId">
                    <div class="fw-semibold">@cliente.NombreCompleto</div>
                    <div class="small text-body-secondary text-break">@string.Join(" · ", new[] { cliente.Email, cliente.Telefono, cliente.Direccion }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                </li>
            }
        </ul>

        <Paginador Pagina="_numero" TotalPaginas="_pagina.TotalPaginas" PaginaCambiada="IrAPagina" />
    </EstadoVista>
</div>

@code {
    private Pagina<Cliente>? _pagina;
    private int _numero = 1;
    private string? _error;

    protected override Task OnInitializedAsync() => Cargar();

    private Task IrAPagina(int numero)
    {
        _numero = numero;
        return Cargar();
    }

    private async Task Cargar()
    {
        _error = null;

        try
        {
            _pagina = await Tienda.ObtenerClientesAsync(_numero, 20);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }
}
