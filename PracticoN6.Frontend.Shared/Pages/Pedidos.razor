@page "/pedidos"
@attribute [Authorize]
@inject TiendaApi Tienda

<div class="container-md py-3">
    <EncabezadoPagina Titulo="Mis pedidos" Icono="box-seam" />

    <EstadoVista Cargando="_pedidos == null" Error="@_error" Vacio="_pedidos?.Count == 0" Reintentar="CargarAsync"
                 IconoVacio="box-seam" MensajeVacio="Todavía no realizó ninguna compra.">
        <AccionesVacio><a class="btn btn-primary" href="">Ver el catálogo</a></AccionesVacio>
        <ChildContent>
            <div class="list-group shadow-sm">
                @foreach (var pedido in _pedidos!)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2 @(pedido.Anulada ? "opacity-50" : "")"
                       href="pedidos/@pedido.VentaId" @key="pedido.VentaId">
                        <div>
                            <div class="fw-semibold">
                                Pedido N° @pedido.VentaId
                                @if (pedido.Anulada)
                                {
                                    <span class="badge text-bg-danger ms-1">Anulado</span>
                                }
                            </div>
                            <div class="small text-body-secondary">
                                @Formato.FechaHora(pedido.Fecha) · @pedido.Items.Sum(i => i.Cantidad) @(pedido.Items.Sum(i => i.Cantidad) == 1 ? "unidad" : "unidades")
                            </div>
                        </div>
                        <div class="fw-bold text-nowrap">@Formato.Dinero(pedido.Total)</div>
                    </a>
                }
            </div>
        </ChildContent>
    </EstadoVista>
</div>

@code {
    private List<Pedido>? _pedidos;
    private string? _error;

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _error = null;

        try
        {
            _pedidos = await Tienda.ObtenerMisPedidosAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
    }
}
